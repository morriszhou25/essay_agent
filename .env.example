# ---------------------------------------------------------------------------
# essay-agent environment configuration
# Copy to `.env` and fill in. Every key can also live in config/default.yaml.
# ---------------------------------------------------------------------------

# --- LLM provider ---------------------------------------------------------
# openai | openai_compatible | deepseek | anthropic
ESSAY_AGENT_LLM__PROVIDER=openai
ESSAY_AGENT_LLM__MODEL=gpt-4o-mini
# Optional: a stronger/cheaper model reserved for the verifier role.
# ESSAY_AGENT_LLM__VERIFIER_MODEL=gpt-4o
# Put YOUR OWN key here and never commit it. Leave it empty to fall back to the
# provider's own variable (OPENAI_API_KEY / DEEPSEEK_API_KEY / ANTHROPIC_API_KEY).
ESSAY_AGENT_LLM__API_KEY=
# Other providers (must match the model name the provider expects):
#   DeepSeek : pip install -e ".[deepseek]" + PROVIDER=deepseek, MODEL=deepseek-chat
#   Anthropic: pip install -e ".[anthropic]" + PROVIDER=anthropic, MODEL=claude-3-5-sonnet-latest
#   Local / any OpenAI-compatible server (vLLM, Ollama, Qwen, Moonshot, OpenRouter, Gemini):
#   PROVIDER=openai_compatible and BASE_URL=http://localhost:8000/v1
# ESSAY_AGENT_LLM__BASE_URL=
ESSAY_AGENT_LLM__TEMPERATURE=0.2
ESSAY_AGENT_LLM__MAX_TOKENS=8192
# The generated repro.py is the longest reply the agent asks for. Raise this when your
# provider allows more output than MAX_TOKENS (DeepSeek accepts 32768; leave empty to
# keep the shared limit).
# ESSAY_AGENT_LLM__CODE_MAX_TOKENS=32768
ESSAY_AGENT_LLM__TIMEOUT=120
ESSAY_AGENT_LLM__MAX_RETRIES=3

# --- network --------------------------------------------------------------
# The one proxy every HTTP client should use (paper search, dataset probe, model API).
# Set this when your proxy is not in the environment variables or the OS settings.
# ESSAY_AGENT_HTTP_PROXY=http://127.0.0.1:7897

# --- runtime / budget -----------------------------------------------------
ESSAY_AGENT_RUNTIME__TIME_BUDGET_SECONDS=600
ESSAY_AGENT_RUNTIME__DEVICE=auto
# Synthetic data is forbidden by design; leave this alone unless you know why.
ESSAY_AGENT_RUNTIME__ALLOW_SYNTHETIC_DATA=false

# --- paths ----------------------------------------------------------------
# Base directory for runs, cache, results and lessons (defaults to CWD).
# ESSAY_AGENT_PATHS__HOME=.

# --- search ---------------------------------------------------------------
ESSAY_AGENT_SEARCH__MAX_RESULTS=8
# Used for the OpenAlex "polite pool" - please set your own address.
ESSAY_AGENT_SEARCH__CONTACT_EMAIL=
# Total budget for the stage-3 reachability probe; raise it on a slow network.
ESSAY_AGENT_SEARCH__CONNECTIVITY_BUDGET_SECONDS=20
# Dataset mirror used when the primary host is unreachable; empty disables it.
# ESSAY_AGENT_SEARCH__DATASET_MIRROR_URL=https://hf-mirror.com
